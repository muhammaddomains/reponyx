{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RepoNyx",
  "version": "0.1.0",
  "identifier": "com.reponyx.app",
  "build": {
    "beforeBuildCommand": "pnpm build",
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "RepoNyx",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost https://api.reponyx.com; font-src 'self' data:;"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "resources": {
      "../../../target/release/reponyx-agent.exe": "reponyx-agent.exe",
      "../../../target/release/reponyx-auth-broker.exe": "reponyx-auth-broker.exe"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "RepoNyx",
    "category": "DeveloperTool",
    "shortDescription": "Your Git. Your Machine. Always in Sync.",
    "longDescription": "RepoNyx synchronizes GitHub repositories to a central local machine as Git mirror archives and working clones.",
    "copyright": "Copyright © 2026 RepoNyx.com. All rights reserved.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English"
        ],
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      },
      "wix": {
        "language": [
          "en-US"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/muhammaddomains/reponyx/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkyMTBFREY0NjdFRjRFRDUKUldUVlR1OW45TzBRa3RHaVFIdll4SWQzZ2hQTStDQ0s3MVVlUjlVNmxuZlZ2L0h0Vloxc0pKVC8K"
    }
  }
}
