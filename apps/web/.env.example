# --- RepoNyx web (.env.example) — copy to .env.local; never commit real values ---
# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Database (Postgres — Neon or any Postgres, e.g. Prisma Postgres; driver auto-detected from the URL host)
DATABASE_URL=
# Email provider: resend | smtp (both credential sets can live here; the variable picks one)
EMAIL_PROVIDER=resend
RESEND_API_KEY=
RESEND_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# GitHub App (the web holds the key — env only, never the repo)
REPONYX_GITHUB_APP_ID=
REPONYX_GITHUB_APP_PRIVATE_KEY=
# OAuth clients (the web is the OAuth client; secrets in env only)
# Callback URLs (registered in the provider consoles — W2 implements exactly these):
# Google: https://reponyx.bond/api/google/oauth/callback
# GitHub: https://reponyx.bond/api/auth/callback/github
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Sessions
SESSION_SECRET=
# --- Billing providers (W6) ---
# Same contract as sendcms .env.example: a provider is enabled in the
# admin ONLY when its env values exist; keys are never shown in the
# admin UI — only whether they are set.
# Stripe
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=
# PayPal
# PAYPAL_MODE=sandbox
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_WEBHOOK_ID=
# Polar
# POLAR_ACCESS_TOKEN=
# POLAR_WEBHOOK_SECRET=
# POLAR_ENVIRONMENT=sandbox
# Freemius
# FREEMIUS_PRODUCT_ID=
# FREEMIUS_API_KEY=
# FREEMIUS_SECRET_KEY=
# FREEMIUS_PUBLIC_KEY=
# FREEMIUS_PLAN_MAP=
# FREEMIUS_SANDBOX=
# Gumroad (registered only — NO checkout: Gumroad has no API to create
# a payment or a subscription, so it can be toggled but never sells
# through checkout)
# GUMROAD_APP_ID=
# GUMROAD_APP_SECRET=
