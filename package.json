{
  "name": "reponyx",
  "version": "0.1.0",
  "private": true,
  "description": "Your Repositories. One Local Universe",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "pnpm --filter @reponyx/desktop build",
    "build:all": "pnpm broker:build && pnpm agent:build && pnpm tauri:build",
    "dev": "pnpm --filter @reponyx/desktop dev",
    "dev:all": "concurrently -k -n broker,agent,desktop \"pnpm broker\" \"pnpm agent\" \"pnpm tauri:dev\"",
    "broker": "cargo run -p reponyx-auth-broker",
    "broker:build": "cargo build -p reponyx-auth-broker",
    "agent": "cargo run -p reponyx-background-agent",
    "agent:build": "cargo build -p reponyx-background-agent",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r clean",
    "tauri:dev": "pnpm --filter @reponyx/desktop tauri dev",
    "tauri:build": "pnpm --filter @reponyx/desktop tauri build"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "concurrently": "^10.0.7",
    "typescript": "^6.0.3"
  }
}
