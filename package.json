{
  "name": "reponyx",
  "version": "0.1.0",
  "private": true,
  "description": "Your Repositories. One Local Universe",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "pnpm --filter @reponyx/desktop build",
    "build:all": "pnpm broker:build && pnpm agent:build && pnpm tauri:build",
    "dev": "pnpm --filter @reponyx/desktop dev",
    "dev:all": "pnpm agent:build && pnpm broker:build && concurrently -k -n broker,agent,desktop \"pnpm broker\" \"pnpm agent\" \"pnpm tauri:dev\"",
    "broker": "cargo run --release -p reponyx-auth-broker",
    "broker:build": "cargo build --release -p reponyx-auth-broker",
    "agent": "cargo run --release -p reponyx-background-agent",
    "agent:build": "cargo build --release -p reponyx-background-agent",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r clean",
    "tauri:dev": "pnpm --filter @reponyx/desktop tauri dev",
    "tauri:build": "pnpm --filter @reponyx/desktop tauri build",
    "web": "pnpm --filter @reponyx/web dev",
    "web:build": "pnpm --filter @reponyx/web build",
    "format": "prettier --write \"apps/web/**/*.{ts,tsx,json,css,mjs}\" \"packages/{i18n,auth,email,database}/**/*.{ts,json}\"",
    "format:check": "prettier --check \"apps/web/**/*.{ts,tsx,json,css,mjs}\" \"packages/{i18n,auth,email,database}/**/*.{ts,json}\""
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "concurrently": "^10.0.7",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "turbo": "2.11.13",
    "typescript": "^6.0.3"
  }
}
